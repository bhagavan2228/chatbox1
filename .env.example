# ==============================================================================
# AI Chat Assistant - Environment Variables Configuration
# ==============================================================================

# Google Gemini API Key (Required for AI responses)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/chatbox

# Backend Server Port (default: 8081)
PORT=8081

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend API Base URL (leave empty in development to use Vite proxy)
VITE_API_BASE_URL=
